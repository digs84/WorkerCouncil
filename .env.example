# Copy this file to ".env" and fill in the keys you actually sign up for.
# You do NOT need all three - the app hops to the next provider only if one
# is missing or exhausted. More providers = more free capacity before you
# ever have to wait or pay.
#
# ---------------------------------------------------------------------------
# 1) Groq  ->  https://console.groq.com/keys  (free, no card required)
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# 2) Google Gemini  ->  https://aistudio.google.com/apikey  (free tier, no card)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# 3) OpenRouter  ->  https://openrouter.ai/keys  (free ":free" models, no card)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional: override the default model hop order / model names without
# touching code. Comma-separated "provider:model" pairs, tried in order.
# Leave unset to use the built-in sensible defaults in app/config.py.
# ---------------------------------------------------------------------------
# LLM_HOP_ORDER=groq:llama-3.3-70b-versatile,groq:llama-3.1-8b-instant,gemini:gemini-2.0-flash,openrouter:nvidia/nemotron-3.5-lightning:free

# Host/port for the local server (defaults shown)
HOST=127.0.0.1
PORT=8000
