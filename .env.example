# Copy this file to ".env" and fill in the keys you actually sign up for.
# You do NOT need all of these - the app hops to the next provider only if
# one is missing or exhausted. More providers = more free capacity before
# you ever have to wait or pay.
#
# ---------------------------------------------------------------------------
# 0) Ollama (optional, LOCAL ONLY) -> https://ollama.com  (unlimited, free,
#    runs on your own machine - not usable by the deployed Netlify site,
#    only by this Python backend running locally)
#
#    1. Install Ollama and pull a model: `ollama pull llama3.1`
#    2. Set OLLAMA_API_KEY below to ANY non-empty value (e.g. "ollama") -
#       Ollama doesn't check it, this just tells the app the hop is enabled.
#    3. If "llama3.1" isn't the model you pulled, either `ollama pull
#       llama3.1` too, or override via LLM_HOP_ORDER below
#       (e.g. LLM_HOP_ORDER=ollama:qwen2.5,groq:openai/gpt-oss-120b,...).
# ---------------------------------------------------------------------------
OLLAMA_API_KEY=

# ---------------------------------------------------------------------------
# 1) Groq  ->  https://console.groq.com/keys  (free, no card required)
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# 2) Google Gemini  ->  https://aistudio.google.com/apikey  (free tier, no card)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# 3) OpenRouter  ->  https://openrouter.ai/keys  (free ":free" models, no card)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Optional: override the default model hop order / model names without
# touching code. Comma-separated "provider:model" pairs, tried in order.
# Leave unset to use the built-in sensible defaults in app/config.py.
# ---------------------------------------------------------------------------
# LLM_HOP_ORDER=groq:llama-3.3-70b-versatile,groq:llama-3.1-8b-instant,gemini:gemini-2.0-flash,openrouter:nvidia/nemotron-3.5-lightning:free

# Host/port for the local server (defaults shown)
HOST=127.0.0.1
PORT=8000
