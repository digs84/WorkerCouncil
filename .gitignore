# netlify/edge-functions/*.js IS committed (not gitignored) even though it's
# generated from netlify-build/templates/ by scripts/fetch-laws.mjs - see the
# note in netlify.toml for why (Netlify's build servers can't reach
# gesetze-im-internet.de, so the fetch has to happen locally and get committed
# instead of running on every Netlify build).
